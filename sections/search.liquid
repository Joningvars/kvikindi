{%- capture search_form -%}
  <form action="{{ routes.search_url }}" method="get" role="search" class="mt-6 flex max-w-xl rounded-full border border-line bg-white p-1.5 focus-within:border-brand-500">
    <label for="SearchInput" class="sr-only">{{ 'search.placeholder' | t }}</label>
    <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" class="min-w-0 flex-1 bg-transparent px-4 text-sm focus:outline-none">
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="btn btn-primary px-5 py-2.5">{% render 'icon', icon: 'search', class: 'size-4' %}{{ 'search.submit' | t }}</button>
  </form>
{%- endcapture -%}
{%- assign page_title = 'search.title' | t -%}
{% render 'page-header', title: page_title, text: search_form %}

<div class="page-width section-y !pt-10">
  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="text-muted">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
    {%- else -%}
      <p class="border-b border-line pb-6 text-sm text-muted">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>
      {%- paginate search.results by 24 -%}
        <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 md:gap-x-6 lg:grid-cols-4">
          {%- for result in search.results -%}
            <li>
              {%- if result.object_type == 'product' -%}
                {% render 'product-card', product: result %}
              {%- else -%}
                <a href="{{ result.url }}" class="card flex h-full flex-col p-6 hover:border-brand-400">
                  <span class="chip w-fit">{{ result.object_type }}</span>
                  <span class="mt-3 font-display text-lg font-bold">{{ result.title }}</span>
                  <span class="mt-2 text-sm text-muted">{{ result.content | strip_html | truncatewords: 20 }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
