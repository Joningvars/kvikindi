      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "bug",
          "options": [
            {
              "value": "rat",
              "label": "Mouse / rat"
            },
            {
              "value": "bug",
              "label": "Insect"
            },
            {
              "value": "snail",
              "label": "Snail"
            },
            {
              "value": "bird",
              "label": "Bird"
            },
            {
              "value": "squirrel",
              "label": "Rodent (squirrel)"
            },
            {
              "value": "spray-can",
              "label": "Spray"
            },
            {
              "value": "sprout",
              "label": "Garden"
            },
            {
              "value": "flower-2",
              "label": "Flower"
            },
            {
              "value": "house",
              "label": "Home"
            },
            {
              "value": "warehouse",
              "label": "Business"
            },
            {
              "value": "shield-check",
              "label": "Shield"
            },
            {
              "value": "badge-check",
              "label": "Badge"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "headset",
              "label": "Support"
            },
            {
              "value": "package-check",
              "label": "Package"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "search",
              "label": "Inspect"
            },
            {
              "value": "phone",
              "label": "Phone"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Þjónusta"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "textarea",
          "id": "points",
          "label": "Bullet points",
