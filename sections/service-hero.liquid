<section class="page-width pt-4 md:pt-6">
  <div class="grid overflow-hidden rounded-panel bg-brand-50 lg:grid-cols-2">
    <div class="flex flex-col justify-center px-6 py-12 sm:px-10 md:px-14 md:py-16">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h-section mt-3 md:text-5xl">{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.text != blank -%}<p class="lede mt-4 max-w-xl">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="mt-6 flex flex-col gap-2.5">
          {%- for block in section.blocks -%}
            <li class="flex items-start gap-3 text-[15px]" {{ block.shopify_attributes }}>
              <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-600 text-white">{% render 'icon', icon: 'check', class: 'size-3' %}</span>
              {{ block.settings.text }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="mt-8 flex flex-wrap gap-3">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#beidni' }}" class="btn btn-primary">{{ section.settings.button_label }}{% render 'icon', icon: 'arrow-right', class: 'size-4' %}</a>
        {%- endif -%}
        {%- if section.settings.show_phone and settings.contact_phone != blank -%}
          <a href="tel:{{ settings.contact_phone | remove: ' ' | remove: '-' }}" class="btn btn-secondary">{% render 'icon', icon: 'phone', class: 'size-4' %}{{ settings.contact_phone }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="relative min-h-72 lg:min-h-full">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 1024px) 640px, 100vw', class: 'absolute inset-0 size-full object-cover', loading: 'eager' }}
      {%- else -%}
        {%- assign fallback = section.settings.fallback_image -%}
        <img src="{{ fallback | asset_img_url: '1200x' }}" srcset="{{ fallback | asset_img_url: '600x' }} 600w, {{ fallback | asset_img_url: '1200x' }} 1200w" sizes="(min-width: 1024px) 640px, 100vw" alt="" class="absolute inset-0 size-full object-cover" width="1200" height="900">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Service hero",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Þjónusta"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the page title"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Placeholder image (when no image is set)",
      "default": "kvikindi-hero-house.jpg",
      "options": [
        {
          "value": "kvikindi-hero-house.jpg",
          "label": "House exterior"
        },
        {
          "value": "kvikindi-why-kitchen.jpg",
          "label": "Kitchen"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Óska eftir þjónustu"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to jump to the request form on this page"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone button",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bullet point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Atriði"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service hero"
    }
  ]
}
{% endschema %}
