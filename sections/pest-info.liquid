{%- liquid
  assign is_row = true
  if section.settings.layout == 'grid'
    assign is_row = false
  endif
  if is_row
    assign ul_class = '-mx-5 flex snap-x snap-mandatory scroll-px-5 gap-3 overflow-x-auto px-5 pb-3 [scrollbar-width:none] md:mx-0 md:flex-wrap md:justify-center md:gap-5 md:overflow-visible md:px-0 md:pb-0'
    assign li_class = 'w-36 shrink-0 snap-start md:w-[calc(33.333%-0.834rem)] lg:w-[calc(25%-0.9375rem)] xl:w-[calc(14.285%-1.0715rem)]'
    assign card_class = 'flex-col items-center px-3 py-5 text-center md:px-4 md:py-7'
    assign icon_wrap = 'size-16 md:size-24'
    assign icon_size = 'size-10 md:size-14'
    assign title_class = 'mt-3 text-base md:mt-5 md:text-xl'
    assign text_class = 'hidden md:block'
  else
    assign ul_class = 'flex flex-col gap-3 md:flex-row md:flex-wrap md:justify-center md:gap-5'
    assign li_class = 'w-full md:w-[calc(50%-0.625rem)] lg:w-[calc(25%-0.9375rem)]'
    assign card_class = 'flex-row items-start gap-4 p-4 text-left md:flex-col md:items-center md:gap-0 md:px-4 md:py-7 md:text-center'
    assign icon_wrap = 'size-14 shrink-0 md:size-24'
    assign icon_size = 'size-9 md:size-14'
    assign title_class = 'text-base md:mt-5 md:text-xl'
    assign text_class = ''
  endif
-%}
<section class="page-width section-y" id="meindyr">
  <div class="max-w-2xl">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h-section mt-3">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lede mt-4">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  <ul class="mt-8 md:mt-14 {{ ul_class }}">
    {%- for block in section.blocks -%}
      <li class="{{ li_class }}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" target="_blank" rel="noopener" class="group card flex h-full {{ card_class }} transition duration-200 hover:-translate-y-0.5 hover:border-brand-400 hover:shadow-card">
        {%- else -%}
          <div class="card flex h-full {{ card_class }}">
        {%- endif -%}
          <span class="flex {{ icon_wrap }} items-center justify-center rounded-full bg-brand-50 text-brand-600 transition-colors duration-200 group-hover:bg-brand-100">
            {% render 'pest-icon', icon: block.settings.icon, class: icon_size %}
          </span>
          <span class="flex min-w-0 flex-1 flex-col {% if is_row %}items-center{% else %}md:items-center{% endif %}">
            <h3 class="font-display font-bold {{ title_class }}">{{ block.settings.name }}</h3>
            {%- if block.settings.text != blank -%}<p class="mt-1 text-sm leading-relaxed text-muted md:mt-2 {{ text_class }}">{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.link != blank and section.settings.link_label != blank -%}
              <span class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-brand-700 group-hover:underline md:mt-auto md:pt-5 md:text-sm">
                {{ section.settings.link_label }}{% render 'icon', icon: 'arrow-up-right', class: 'size-3.5' %}
              </span>
            {%- endif -%}
          </span>
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
  {%- if section.settings.source_note != blank -%}
    <p class="mt-6 text-sm text-muted">{{ section.settings.source_note }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Pest guide",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Meindýr"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Algeng meindýr á Íslandi"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Card link label",
      "default": "Nánar hjá Náttúrufræðistofnun"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "row",
          "label": "One row on wide screens (up to 7)"
        },
        {
          "value": "grid",
          "label": "Grid, 4 per row"
        }
      ],
      "default": "row"
    },
    {
      "type": "text",
      "id": "source_note",
      "label": "Source note"
    }
  ],
  "blocks": [
    {
      "type": "pest",
      "name": "Pest",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "mouse",
              "label": "Mouse / rat"
            },
            {
              "value": "wasp",
              "label": "Wasp"
            },
            {
              "value": "bedbug",
              "label": "Bed bug"
            },
            {
              "value": "cockroach",
              "label": "Cockroach"
            },
            {
              "value": "silverfish",
              "label": "Silverfish"
            },
            {
              "value": "ant",
              "label": "Ant"
            },
            {
              "value": "earwig",
              "label": "Earwig"
            },
            {
              "value": "flea",
              "label": "Flea"
            },
            {
              "value": "beetle",
              "label": "Beetle (larder / carpet)"
            },
            {
              "value": "woodworm",
              "label": "Woodworm"
            },
            {
              "value": "moth",
              "label": "Moth"
            },
            {
              "value": "bird",
              "label": "Bird"
            }
          ],
          "default": "mouse"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Mýs og rottur"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (e.g. Náttúrufræðistofnun)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pest guide",
      "blocks": [
        {
          "type": "pest"
        }
      ]
    }
  ]
}
{% endschema %}
