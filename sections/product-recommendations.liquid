{%- comment -%}
  Shopify's automatic product recommendations. The shell renders empty, then JS fetches this
  same section through the Section Rendering API with the product id, which fills `recommendations`.
{%- endcomment -%}
{%- if settings.shop_enabled or request.design_mode -%}
<div
  class="bg-mist"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"
  {% unless recommendations.performed and recommendations.products_count > 0 %}hidden{% endunless %}
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width section-y">
      <div class="max-w-2xl">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h-section mt-4">{{ section.settings.heading }}</h2>
      </div>
      <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 md:mt-12 md:gap-x-6 lg:grid-cols-4">
        {%- for product in recommendations.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{%- unless recommendations.performed -%}
  <script>
    (() => {
      const el = document.currentScript.previousElementSibling;
      if (!el || !el.matches('[data-recommendations]')) return;
      const load = () =>
        fetch(el.dataset.url)
          .then((r) => r.text())
          .then((html) => {
            const fresh = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-recommendations]');
            if (fresh && fresh.innerHTML.trim()) {
              el.innerHTML = fresh.innerHTML;
              el.hidden = false;
            }
          })
          .catch(() => {});
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load(); }
        }, { rootMargin: '0px 0px 400px 0px' });
        io.observe(el.parentElement);
      } else {
        load();
      }
    })();
  </script>
{%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "Product recommendations",
  "tag": "div",
  "class": "min-h-px",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Products are picked automatically by Shopify. Fine-tune them with the free Search & Discovery app." },
    {
      "type": "select", "id": "intent", "label": "Type", "default": "related",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary (set in Search & Discovery)" }
      ]
    },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Þér gæti líka líkað" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tengdar vörur" }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
