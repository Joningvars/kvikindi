<section class="page-width pb-16 md:pb-24">
  <div class="relative isolate overflow-hidden rounded-panel bg-brand-800 px-6 py-12 sm:px-10 md:px-16 md:py-16">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 size-80 rounded-full bg-brand-600/40 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-32 left-1/3 -z-10 size-80 rounded-full bg-brand-500/20 blur-3xl"></div>
    <div class="grid items-center gap-8 md:grid-cols-[minmax(0,1fr)_auto]">
      <div class="max-w-2xl">
        <h2 class="h-section text-white">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="mt-4 text-base text-white/75 md:text-lg">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      <div class="flex flex-wrap gap-3">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.root_url }}" class="btn btn-white">
            {{ section.settings.button_label }}
            {%- render 'icon', icon: 'arrow-right', class: 'size-4' -%}
          </a>
        {%- endif -%}
        {%- if section.settings.show_phone and settings.contact_phone != blank -%}
          <a href="tel:{{ settings.contact_phone | remove: ' ' | remove: '-' }}" class="btn btn-ghost-light">
            {%- render 'icon', icon: 'phone', class: 'size-4' -%}
            {{ settings.contact_phone }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call to action",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stærra vandamál? Fáðu fagmann á staðinn." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Kvikindi sinnir meindýravörnum fyrir heimili og fyrirtæki. Hafðu samband og við finnum lausn." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Hafa samband" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_phone", "label": "Show phone number", "default": true }
  ],
  "presets": [{ "name": "Call to action" }]
}
{% endschema %}
