{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="page-width flex min-h-[70vh] items-center justify-center py-16">
  <div class="w-full max-w-md rounded-panel bg-mist p-8 text-center md:p-10">
    <span class="mx-auto flex size-12 items-center justify-center rounded-full bg-brand-600 text-white">{% render 'icon', icon: 'shield-check', class: 'size-6' %}</span>
    <h1 class="mt-5 font-display text-2xl font-bold">{{ 'password.title' | t }}</h1>
    {%- if shop.password_message -%}<p class="mt-3 text-muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'mt-6 flex flex-col gap-3' -%}
      {%- if form.errors -%}<div class="text-sm text-sale">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label for="password-input" class="sr-only">{{ 'password.password' | t }}</label>
      <input type="password" name="password" id="password-input" class="field" placeholder="{{ 'password.password' | t }}">
      <button type="submit" class="btn btn-primary">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
