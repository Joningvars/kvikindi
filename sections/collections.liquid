{%- assign page_title = 'collections.title' | t -%}
{% render 'page-header', title: page_title %}

<div class="page-width section-y !pt-10">
  <ul class="grid gap-4 sm:grid-cols-2 md:gap-5 lg:grid-cols-3">
    {%- for c in collections -%}
      <li>
        <a href="{{ c.url }}" class="group card flex h-full flex-col overflow-hidden transition hover:-translate-y-0.5 hover:border-brand-400 hover:shadow-card">
          <div class="aspect-[16/10] overflow-hidden bg-mist">
            {%- if c.featured_image -%}
              {{ c.featured_image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw', class: 'size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]', loading: 'lazy' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'size-full fill-brand-200' }}
            {%- endif -%}
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h2 class="font-display text-xl font-bold">{{ c.title }}</h2>
            <p class="mt-1 text-sm text-muted">{{ 'collections.products_count' | t: count: c.products_count }}</p>
            <span class="link-arrow mt-auto pt-5">{{ 'collections.view' | t }}{% render 'icon', icon: 'arrow-right', class: 'size-4' %}</span>
          </div>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
