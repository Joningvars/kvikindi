{%- liquid
  assign c = section.settings.collection
  assign limit = section.settings.limit
  assign has_products = false
  if c != blank and c.products_count > 0
    assign has_products = true
  endif
-%}
{%- if has_products or request.design_mode -%}
<section class="bg-mist">
  <div class="page-width section-y">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h-section mt-4">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lede mt-4">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ c.url | default: routes.all_products_collection_url }}" class="link-arrow shrink-0">
          {{ section.settings.link_label }}
          {%- render 'icon', icon: 'arrow-right', class: 'size-4' -%}
        </a>
      {%- endif -%}
    </div>

    <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 md:mt-14 md:gap-x-6 lg:grid-cols-4">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <li>{% render 'product-card', index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Featured products",
  "tag": "div",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Vinsælast" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mest seldu vörurnar" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Skoða allar vörur" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
