<section class="page-width section-y">
  <div class="max-w-2xl">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h-section mt-3">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lede mt-4">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  <ul class="mt-10 grid gap-5 md:mt-12 md:grid-cols-2">
    {%- for block in section.blocks -%}
      <li class="flex flex-col gap-6 rounded-panel bg-white p-6 ring-1 ring-line sm:flex-row md:p-8" {{ block.shopify_attributes }}>
        <div class="aspect-square w-28 shrink-0 overflow-hidden rounded-card bg-brand-50 sm:w-36">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '144px', class: 'size-full object-cover', loading: 'lazy', alt: block.settings.name }}
          {%- else -%}
            <div class="flex size-full items-center justify-center text-brand-600">{% render 'icon', icon: 'user', class: 'size-10' %}</div>
          {%- endif -%}
        </div>
        <div class="min-w-0 flex-1">
          <h3 class="font-display text-xl font-bold">{{ block.settings.name }}</h3>
          {%- if block.settings.role != blank -%}<p class="text-sm text-muted">{{ block.settings.role }}</p>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="mt-3 text-[15px] leading-relaxed">{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.certs != blank -%}
            <ul class="mt-4 flex flex-col gap-2 text-sm">
              {%- assign lines = block.settings.certs | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign line = line | strip -%}
                {%- if line != blank -%}
                  <li class="flex items-start gap-2.5"><span class="mt-0.5 text-brand-600">{% render 'icon', icon: 'badge-check', class: 'size-4' %}</span>{{ line }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Team",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Teymið"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fólkið á bak við Kvikindi"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Nafn"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Short bio"
        },
        {
          "type": "textarea",
          "id": "certs",
          "label": "Licences and certificates",
          "info": "One per line"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team"
    }
  ]
}
{% endschema %}
