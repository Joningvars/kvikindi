{%- liquid
  assign limit = section.settings.limit
  if limit == 0
    assign limit = 50
  endif
-%}
<section class="{% if section.settings.tinted %}bg-mist{% endif %}">
  <div class="page-width section-y">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h-section mt-3">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lede mt-4">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and section.blocks.size > limit -%}
        <a href="{{ section.settings.link | default: '#' }}" class="btn btn-secondary shrink-0 self-start md:self-auto">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 md:mt-12 md:gap-5 {% if section.settings.columns == '4' %}lg:grid-cols-3 xl:grid-cols-4{% else %}lg:grid-cols-3{% endif %}">
      {%- for block in section.blocks limit: limit -%}
        <li class="flex flex-col rounded-card bg-white p-6 text-center ring-1 ring-line md:p-7" {{ block.shopify_attributes }}>
          {%- if block.settings.issuer != blank -%}
            <p class="text-xs font-bold tracking-[0.08em] text-brand-700 uppercase">{{ block.settings.issuer }}</p>
          {%- endif -%}
          <h3 class="mt-3 font-display text-lg leading-snug font-bold text-balance">{{ block.settings.title }}</h3>

          <div class="mt-5 flex aspect-[4/3] items-center justify-center overflow-hidden rounded-lg bg-mist ring-1 ring-line">
            {%- if block.settings.image != blank -%}
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener" class="block size-full">{%- endif -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 1280px) 300px, (min-width: 640px) 45vw, 90vw', class: 'size-full object-contain p-2', loading: 'lazy', alt: block.settings.title }}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            {%- else -%}
              <div class="flex flex-col items-center gap-3 px-6 text-muted">
                <span class="flex size-14 items-center justify-center rounded-full bg-white text-brand-600 shadow-card">{% render 'icon', icon: 'badge-check', class: 'size-7' %}</span>
                {%- if request.design_mode -%}<span class="text-xs">{{ 'credentials.add_image' | t }}</span>{%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.holder != blank or block.settings.number != blank or block.settings.date != blank -%}
            <div class="mt-4 flex flex-col gap-0.5 text-sm">
              {%- if block.settings.holder != blank -%}<p class="font-semibold">{{ block.settings.holder }}</p>{%- endif -%}
              {%- if block.settings.number != blank or block.settings.date != blank -%}
                <p class="text-muted">
                  {%- if block.settings.number != blank -%}{{ 'credentials.number' | t }} {{ block.settings.number }}{%- endif -%}
                  {%- if block.settings.number != blank and block.settings.date != blank %} · {% endif -%}
                  {%- if block.settings.date != blank -%}{{ block.settings.date }}{%- endif -%}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if block.settings.link != blank and block.settings.image == blank -%}
            <a href="{{ block.settings.link }}" class="link-arrow mx-auto mt-4" target="_blank" rel="noopener">{{ 'credentials.view' | t }}{% render 'icon', icon: 'arrow-right', class: 'size-4' %}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Credentials",
  "tag": "div",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Réttindi"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Leyfi og vottanir"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on large screens",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Cards to show",
      "info": "0 shows all",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label (when some cards are hidden)",
      "default": "Öll réttindi"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "tinted",
      "label": "Tinted background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "certificate",
      "name": "Certificate",
      "settings": [
        {
          "type": "text",
          "id": "issuer",
          "label": "Issued by (small label)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Licence / certificate",
          "default": "Heiti leyfis"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image of the certificate"
        },
        {
          "type": "text",
          "id": "holder",
          "label": "Holder(s)"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to PDF (optional)",
          "info": "Upload the PDF in Content → Files and paste its link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Credentials"
    }
  ]
}
{% endschema %}
