<section class="page-width section-y">
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h-section mt-3">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede mt-4">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ul class="grid gap-4 {% if section.blocks.size == 2 %}sm:grid-cols-2{% endif %}">
      {%- for block in section.blocks -%}
        <li class="relative overflow-hidden rounded-card bg-white p-6 ring-1 ring-line md:p-7" {{ block.shopify_attributes }}>
          <div class="absolute inset-y-0 left-0 w-1.5 bg-brand-500"></div>
          <div class="flex items-start gap-4">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700">{% render 'icon', icon: 'badge-check', class: 'size-6' %}</span>
            <div class="min-w-0">
              <p class="font-display text-lg leading-snug font-bold">{{ block.settings.title }}</p>
              {%- if block.settings.issuer != blank -%}<p class="mt-0.5 text-sm text-muted">{{ block.settings.issuer }}</p>{%- endif -%}
            </div>
          </div>
          {%- assign has_details = false -%}
          {%- if block.settings.holder != blank or block.settings.number != blank or block.settings.date != blank -%}{%- assign has_details = true -%}{%- endif -%}
          {%- if has_details -%}
          <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-line pt-5 text-sm">
            {%- if block.settings.holder != blank -%}
              <div class="col-span-2"><dt class="text-xs text-muted">{{ 'credentials.holder' | t }}</dt><dd class="font-semibold">{{ block.settings.holder }}</dd></div>
            {%- endif -%}
            {%- if block.settings.number != blank -%}
              <div><dt class="text-xs text-muted">{{ 'credentials.number' | t }}</dt><dd class="font-semibold">{{ block.settings.number }}</dd></div>
            {%- endif -%}
            {%- if block.settings.date != blank -%}
              <div><dt class="text-xs text-muted">{{ 'credentials.date' | t }}</dt><dd class="font-semibold">{{ block.settings.date }}</dd></div>
            {%- endif -%}
          </dl>
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="link-arrow mt-5" target="_blank" rel="noopener">{{ 'credentials.view' | t }}{% render 'icon', icon: 'arrow-right', class: 'size-4' %}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Credentials",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Réttindi"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vottuð þekking"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Starfsfólk Kvikinda hefur lokið viðurkenndri þjálfun í meindýravörnum."
    }
  ],
  "blocks": [
    {
      "type": "certificate",
      "name": "Certificate",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Certificate",
          "default": "Heiti vottunar"
        },
        {
          "type": "text",
          "id": "issuer",
          "label": "Issued by"
        },
        {
          "type": "text",
          "id": "holder",
          "label": "Holder"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Certificate number"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to certificate (optional)",
          "info": "Upload the PDF in Content → Files and paste its link here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Credentials"
    }
  ]
}
{% endschema %}
