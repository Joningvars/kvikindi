<header>
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="header__icons">
    {%- if localization.available_languages.size > 1 -%}
      {%- liquid
        assign current_path = request.path
        if request.locale.root_url != '/'
          assign current_path = current_path | remove_first: request.locale.root_url
        endif
        if current_path == blank
          assign current_path = '/'
        endif
      -%}
      <nav class="header__languages" aria-label="{{ 'header.language' | t }}">
        {%- for language in localization.available_languages -%}
          {%- liquid
            if language.root_url == '/'
              assign language_url = current_path
            elsif current_path == '/'
              assign language_url = language.root_url
            else
              assign language_url = language.root_url | append: current_path
            endif
          -%}
          <a
            href="{{ language_url }}"
            hreflang="{{ language.iso_code }}"
            lang="{{ language.iso_code }}"
            {% if language.iso_code == request.locale.iso_code %}
              aria-current="true"
            {% else %}
              aria-label="{{ 'header.language_link' | t: language: language.endonym_name }}"
            {% endif %}
          >
            {{- language.iso_code | upcase -}}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header .header__languages {
    display: flex;
    gap: 0.5rem;
    font-size: 0.875rem;
  }
  header .header__languages a[aria-current] {
    font-weight: 700;
  }
  header svg {
    width: 2rem;
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
