            },
            {
              "value": "bird",
              "label": "Bird"
            },
            {
              "value": "squirrel",
              "label": "Rodent (squirrel)"
            },
            {
              "value": "spray-can",
              "label": "Spray"
            },
            {
              "value": "sprout",
              "label": "Garden"
            },
            {
              "value": "flower-2",
              "label": "Flower"
            },
            {
              "value": "house",
              "label": "Home"
            },
            {
              "value": "warehouse",
              "label": "Business"
            },
            {
              "value": "shield-check",
              "label": "Shield"
            },
            {
              "value": "badge-check",
              "label": "Badge"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "headset",
              "label": "Support"
            },
            {
              "value": "package-check",
              "label": "Package"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "search",
              "label": "Inspect"
            },
            {
              "value": "phone",
              "label": "Phone"
            }
          ]
        },
        {
          "type": "select",
          "id": "pest_icon",
          "label": "Pest illustration (replaces icon)",
          "options": [
            {
              "value": "",
              "label": "None"
            },
            {
              "value": "mouse",
              "label": "Mouse / rat"
            },
            {
              "value": "wasp",
              "label": "Wasp"
            },
            {
              "value": "bedbug",
              "label": "Bed bug"
            },
            {
              "value": "cockroach",
              "label": "Cockroach"
            },
