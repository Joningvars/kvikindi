<section class="page-width section-y">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h-section mt-3">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte lede mt-4">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.show_page_content and page.content != blank -%}
        <div class="rte mt-6 text-[15px]">{{ page.content }}</div>
      {%- endif -%}
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {%- for block in section.blocks -%}
        <div class="rounded-card bg-mist p-6" {{ block.shopify_attributes }}>
          {%- if block.settings.pest_icon != blank -%}
            <span class="flex size-16 items-center justify-center rounded-full bg-white text-brand-600 shadow-card">{% render 'pest-icon', icon: block.settings.pest_icon, class: 'size-10' %}</span>
          {%- else -%}
            <span class="flex size-10 items-center justify-center rounded-full bg-white text-brand-600 shadow-card">{% render 'icon', icon: block.settings.icon, class: 'size-5' %}</span>
          {%- endif -%}
          <h3 class="mt-4 font-display text-lg font-bold">{{ block.settings.title }}</h3>
          <div class="rte mt-2 text-sm text-muted">{{ block.settings.text }}</div>
          {%- if block.settings.link != blank and section.settings.link_label != blank -%}
            <a href="{{ block.settings.link }}" target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:underline">{{ section.settings.link_label }}{% render 'icon', icon: 'arrow-up-right', class: 'size-3.5' %}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Info columns",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hvað felst í þjónustunni"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "Show the page's own content",
