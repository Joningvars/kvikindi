{%- doc -%}
  IS / EN switcher. Plain links that keep the current path. Renders nothing with one published language.
  @param {string} [class] - Wrapper classes
  @param {string} [active_class] - Classes for the current language
{%- enddoc -%}
{%- if localization.available_languages.size > 1 -%}
  {%- liquid
    assign current_path = request.path
    if request.locale.root_url != '/'
      assign current_path = current_path | remove_first: request.locale.root_url
    endif
    if current_path == blank
      assign current_path = '/'
    endif
  -%}
  <nav class="{{ class | default: 'flex items-center gap-1' }}" aria-label="{{ 'header.language' | t }}">
    {%- for language in localization.available_languages -%}
      {%- liquid
        if language.root_url == '/'
          assign language_url = current_path
        elsif current_path == '/'
          assign language_url = language.root_url
        else
          assign language_url = language.root_url | append: current_path
        endif
      -%}
      <a
        href="{{ language_url }}"
        hreflang="{{ language.iso_code }}"
        lang="{{ language.iso_code }}"
        class="rounded-full px-2 py-0.5 text-xs font-semibold {% if language.iso_code == request.locale.iso_code %}{{ active_class | default: 'bg-white/15' }}{% else %}opacity-75 hover:opacity-100{% endif %}"
        {% if language.iso_code == request.locale.iso_code %}
          aria-current="true"
        {% else %}
          aria-label="{{ 'header.language_link' | t: language: language.endonym_name }}"
        {% endif %}
      >
        {{- language.iso_code | upcase -}}
      </a>
    {%- endfor -%}
  </nav>
{%- endif -%}
