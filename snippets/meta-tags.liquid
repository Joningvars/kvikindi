<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign default_description = 'meta.default_description' | t
  assign page_meta_description = ''
  if request.page_type == 'page' and template.suffix != blank
    assign page_meta_key = template.suffix | replace: '-', '_' | prepend: 'meta.pages.'
    assign page_meta_description = page_meta_key | t
    if page_meta_description contains 'translation missing'
      assign page_meta_description = ''
    endif
  endif
  if request.page_type == 'index'
    assign og_description = page_description | default: default_description
  else
    assign og_description = page_description | default: page_meta_description | default: shop.description | default: default_description
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- unless page_image -%}
  <meta property="og:image" content="https:{{ 'kvikindi-hero-house.jpg' | asset_img_url: '1200x' }}">
  <meta property="og:image:secure_url" content="https:{{ 'kvikindi-hero-house.jpg' | asset_img_url: '1200x' }}">
{%- endunless -%}
{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

<meta
  name="description"
  content="{{ og_description | escape }}"
>

{%- liquid
  assign org_type = 'Organization'
  if settings.contact_address != blank
    assign org_type = 'LocalBusiness'
  endif
  assign org_name = settings.company_name | default: shop.name
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": {{ org_type | json }},
        "@id": {{ request.origin | append: '/#organization' | json }},
        "name": {{ org_name | json }},
        "url": {{ request.origin | append: routes.root_url | json }},
        "logo": {{ 'kvikindi-logo.svg' | asset_url | prepend: 'https:' | json }},
        "image": {{ 'kvikindi-hero-house.jpg' | asset_img_url: '1200x' | prepend: 'https:' | json }},
        "description": {{ default_description | json }}
        {%- if settings.contact_phone != blank -%},"telephone": {{ settings.contact_phone | json }}{%- endif -%}
        {%- if settings.contact_email != blank -%},"email": {{ settings.contact_email | json }}{%- endif -%}
        {%- if settings.contact_address != blank -%},"address": {{ settings.contact_address | strip_newlines | json }}{%- endif -%}
        {%- if settings.company_kennitala != blank -%},"taxID": {{ settings.company_kennitala | json }}{%- endif -%}
        {%- assign same_as = '' -%}
        {%- if settings.social_facebook != blank -%}{%- assign same_as = same_as | append: settings.social_facebook | append: '|' -%}{%- endif -%}
        {%- if settings.social_instagram != blank -%}{%- assign same_as = same_as | append: settings.social_instagram | append: '|' -%}{%- endif -%}
        {%- if same_as != blank -%},"sameAs": {{ same_as | split: '|' | json }}{%- endif -%}
      },
      {
        "@type": "WebSite",
        "@id": {{ request.origin | append: '/#website' | json }},
        "name": {{ org_name | json }},
        "url": {{ request.origin | append: routes.root_url | json }},
        "inLanguage": {{ request.locale.iso_code | json }},
        "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} }
      }
    ]
  }
</script>
