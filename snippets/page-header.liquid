{%- doc -%}
  Soft green-grey page header band used on collection, search and content pages.
  @param {string} title - Page title
  @param {string} [eyebrow] - Small label above the title
  @param {string} [text] - Intro text (HTML allowed)
{%- enddoc -%}
<div class="page-width pt-4 md:pt-6">
  <div class="relative isolate overflow-hidden rounded-panel bg-brand-50 px-6 py-12 sm:px-10 md:px-14 md:py-16">
    <div class="pointer-events-none absolute -top-20 -right-20 -z-10 size-72 rounded-full bg-brand-100 blur-2xl"></div>
    {%- if eyebrow != blank -%}<p class="eyebrow">{{ eyebrow }}</p>{%- endif -%}
    <h1 class="h-section mt-4 max-w-3xl">{{ title }}</h1>
    {%- if text != blank -%}<div class="rte lede mt-4 max-w-2xl">{{ text }}</div>{%- endif -%}
  </div>
</div>
